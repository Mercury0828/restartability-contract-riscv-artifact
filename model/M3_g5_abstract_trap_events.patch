diff --git a/model/core/restartv_trap_events.sail b/model/core/restartv_trap_events.sail
new file mode 100644
index 0000000..6e71ed8
--- /dev/null
+++ b/model/core/restartv_trap_events.sail
@@ -0,0 +1,54 @@
+// =======================================================================================
+// RESTART-V M3 / E-track gap G5: abstract (Cat-visible) trap / xret / CSR-write events.
+//
+// The upstream Sail RISC-V model emits exactly ONE abstract concurrency-interface event
+// that Isla surfaces to the axiomatic (Cat) layer: `sail_barrier`. Trap entry, xret (mret/
+// sret) and CSR writes are ordinary Sail function/register effects -> Isla `other_events`
+// (include_in_smt = false) -> invisible to the Cat model. That is the whole G5 gap.
+//
+// The mechanism that makes `sail_barrier` Cat-visible is the concurrency-interface `outcome`
+// with ONLY an `emulator` implementation (no `isla`/`emulator_or_isla` impl): the isla-sail
+// `instantiate_outcomes["isla"]` rewrite then finds no isla implementation and marks the
+// call `abstract` in the JIB IR (`abstract z... = "..."`), which Isla lowers to
+// `Event::Abstract { primitive = true }` -> smt_events -> Cat-visible.
+//
+// We declare three such outcomes mirroring `sail_barrier` EXACTLY (same shape, same
+// `impl emulator(_) = ()`), so isla-sail marks them abstract for the isla target while the
+// C emulator keeps a no-op. Names are chosen to match `litmus/cat/riscv_trap.cat`'s
+// accessors (`is sail_mret`, `is sail_trap`, `is sail_write_CSR`) so that G5's aspirational
+// vocabulary populates with no Cat edit.
+//
+// SPDX-License-Identifier: BSD-2-Clause
+// =======================================================================================
+
+$sail_internal
+
+$include <concurrency_interface/common.sail>
+
+// Synchronous trap / interrupt entry. Argument: the trap cause (exc_code = bits(6)).
+outcome sail_trap : 'trap_id -> unit
+with
+  'trap_id : Type
+= {
+    impl emulator(_) = ()
+}
+
+// xret effect (mret <-> true, sret <-> false).
+outcome sail_mret : 'xret_id -> unit
+with
+  'xret_id : Type
+= {
+    impl emulator(_) = ()
+}
+
+// Architectural CSR write. Argument: the CSR address (csreg = bits(12)).
+outcome sail_write_CSR : 'csr_id -> unit
+with
+  'csr_id : Type
+= {
+    impl emulator(_) = ()
+}
+
+instantiation sail_trap with 'trap_id = exc_code
+instantiation sail_mret with 'xret_id = bool
+instantiation sail_write_CSR with 'csr_id = csreg
